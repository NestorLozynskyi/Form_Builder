{
	# Local default: plain HTTP on :80 inside the container (published on CADDY_HTTP_PORT).
	# For a real domain set SITE_ADDRESS=forms.example.com and ACME_EMAIL; Caddy then obtains
	# certificates automatically and serves HTTPS on :443 (published on CADDY_HTTPS_PORT).
	email {$ACME_EMAIL:admin@localhost}
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Security headers for every response (SPA and API).
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Angular binds component styles inline, so style-src needs 'unsafe-inline'; scripts are same-origin only.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Public form pages and the public API are never indexed (the page also sets <meta name="robots" content="noindex">).
	@public path /f/* /api/public/*
	header @public X-Robots-Tag "noindex, nofollow"

	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8080}
	}

	handle {
		root * /srv
		# Hashed bundles can be cached forever; everything else (index.html for every SPA route) is revalidated.
		@hashed path_regexp -[0-9A-Za-z_-]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path_regexp -[0-9A-Za-z_-]{8}\.(js|css)$
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
