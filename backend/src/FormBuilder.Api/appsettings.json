{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "RateLimits": {
    "AuthPermitLimit": 10,
    "SubmitPermitLimit": 10,
    "WindowSeconds": 60
  }
}
