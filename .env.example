# Copy to .env and adjust. All values are optional; defaults are shown.

# Docker Compose project name (keeps containers/volumes/networks separate from other stacks).
COMPOSE_PROJECT_NAME=form-builder

# --- Caddy (public entry point) ---
# Host interface and ports Caddy is published on.
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTP_PORT=8180
CADDY_HTTPS_PORT=8543
# Site address. ":80" = plain HTTP (local). For a real domain use e.g. "forms.example.com":
# Caddy then issues certificates automatically (requires public DNS + ports 80/443 reachable,
# i.e. CADDY_BIND_ADDRESS=0.0.0.0, CADDY_HTTP_PORT=80, CADDY_HTTPS_PORT=443).
SITE_ADDRESS=:80
ACME_EMAIL=admin@localhost

# --- PostgreSQL ---
# Local development defaults only. Set your own strong password for any shared or production deployment.
POSTGRES_DB=formbuilder
POSTGRES_USER=formbuilder
POSTGRES_PASSWORD=formbuilder
# Host port used only with compose.db-port.yaml (PostgreSQL is not published by default).
POSTGRES_HOST_PORT=5442

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Production
# Apply EF Core migrations when the backend starts (set false to run them as a separate step).
APPLY_MIGRATIONS_ON_STARTUP=true
# Rate limits (fixed window per client IP): sign-in + sign-up, and public submissions per form.
RATE_LIMIT_AUTH_PER_WINDOW=10
RATE_LIMIT_SUBMIT_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- E2E (Playwright) ---
E2E_BASE_URL=http://127.0.0.1:8180

# --- Frontend dev server (ng serve) ---
API_PROXY_TARGET=http://localhost:5180
